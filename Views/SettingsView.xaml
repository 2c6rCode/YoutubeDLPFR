<UserControl x:Class="YtDlpGui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YtDlpGui.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <!-- Component / Dependency Updates Card -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Core Executables &amp; Updates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- yt-dlp Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="yt-dlp Version:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding YtDlpVersion, StringFormat='v{0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Browse Executable..." Command="{Binding BrowseYtDlpPathCommand}" 
                                Height="34" Padding="12,0" Margin="0,0,10,0" FontSize="12"
                                Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>

                        <!-- Update Button (yt-dlp -U) -->
                        <Button Grid.Column="3" Command="{Binding UpdateYtDlpSelfCommand}" 
                                Height="34" Padding="16,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Update yt-dlp (yt-dlp -U)"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCheckingUpdates}" Value="True">
                                                                            <Setter Property="Text" Value="Updating..."/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Custom yt-dlp Path textbox -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Custom Path:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Settings.YtDlpPath, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="12" Height="30" Padding="8,4" VerticalContentAlignment="Center"
                                 ToolTip="Leave empty to use automatic system yt-dlp"/>
                    </Grid>

                    <!-- FFmpeg Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FFmpeg Status:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding FfmpegVersion}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Button Grid.Column="2" Content="Browse FFmpeg..." Command="{Binding BrowseFfmpegPathCommand}" 
                                Height="34" Padding="12,0" FontSize="12"
                                Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                    </Grid>

                    <!-- Update Status Output Banner -->
                    <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding UpdateStatus, Converter={StaticResource StringIsNullOrEmptyConverter}, ConverterParameter=true}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Download Directories & Defaults Card -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Download Storage &amp; Defaults" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Default Download Path:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Settings.DefaultDownloadPath, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Height="34" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Change..." Command="{Binding BrowseDownloadPathCommand}" 
                                Height="34" Padding="14,0" FontSize="12"
                                Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Max Retries:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Settings.MaxRetries, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="30" FontSize="13" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="3" Text="Concurrent Downloads:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" Text="{Binding Settings.MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="30" FontSize="13" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Video & Audio Metadata Preferences Card -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Post-Processing &amp; Embedding" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,0">
                        <CheckBox Content="Embed Metadata (Title, Artist, Tags)" IsChecked="{Binding Settings.EmbedMetadata}" FontSize="13" Margin="0,0,24,12"/>
                        <CheckBox Content="Embed Thumbnail" IsChecked="{Binding Settings.EmbedThumbnail}" FontSize="13" Margin="0,0,24,12"/>
                        <CheckBox Content="Download Subtitles" IsChecked="{Binding Settings.DownloadSubtitles}" FontSize="13" Margin="0,0,24,12"/>
                        <CheckBox Content="Embed Subtitles into Video" IsChecked="{Binding Settings.EmbedSubtitles}" FontSize="13" Margin="0,0,24,12"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>