<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YtDlpGui</AssemblyName>
    <RootNamespace>YtDlpGui</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>YtDlpGui</Authors>
    <Description>Professional GUI frontend for yt-dlp</Description>
    <Copyright>Copyright © 2024</Copyright>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <StartupObject>YtDlpGui.App</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <WpfTempProjectOutputPath>$(BaseIntermediateOutputPath)</WpfTempProjectOutputPath>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>YtDlpGui.pfx</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="YtDlpGui.pfx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Sign the output exe after build using the self-signed cert from the cert store -->
  <Target Name="SignOutput" AfterTargets="Build">
    <PropertyGroup>
      <ExeToSign>$(OutputPath)$(AssemblyName).exe</ExeToSign>
      <CertThumbprint>7BC682AD4F399E8892535A64A93B37D640B1030D</CertThumbprint>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -Command &quot;$cert = Get-Item Cert:\CurrentUser\My\$(CertThumbprint); Set-AuthenticodeSignature -FilePath '$(ExeToSign)' -Certificate $cert -HashAlgorithm SHA256 -TimestampServer 'http://timestamp.digicert.com'&quot;" ContinueOnError="true" />
  </Target>

</Project>